---
import HeroSection from '../components/HeroSection.astro';
import PartnersSection from '../components/PartnersSection.astro';
import AboutSection from '../components/AboutSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ResourcesSection from '../components/ResourcesSection.astro';
import ContactSection from '../components/ContactSection.astro';
import WhyUsItem from '../components/WhyUsItem.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import MainLayout from '../layouts/MainLayout.astro';
import { brand } from '../data/brand';
import { whyUs, testimonials } from '../data';
---

<MainLayout
  title={brand.meta.homeTitle}
  description={brand.meta.homeDescription}
  canonicalPath="/"
  activeNav="inicio"
  contentClass="pt-0"
>
  <HeroSection />

  <PartnersSection />

  <!-- Stats futuristas -->
  <section class="border-y border-[#595B5B]/40 bg-[#1C1D1D] py-14 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_center,_rgba(238,118,1,0.14)_0%,_transparent_70%)]"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

        <div class="stat-card relative bg-white/[0.03] border border-[#EE7601]/20 rounded-2xl p-6 flex flex-col items-center gap-3">
          <span class="absolute top-3 right-3 w-1.5 h-1.5 rounded-full bg-[#EE7601] animate-pulse"></span>
          <div class="stat-icon-box w-12 h-12 rounded-xl bg-[#EE7601]/10 border border-[#EE7601]/20 flex items-center justify-center text-[#EE7601] text-2xl">
            <i class="ph ph-seal-check" aria-hidden="true"></i>
          </div>
          <p class="stat-value text-2xl font-semibold text-slate-100 tracking-tight">ISO</p>
          <p class="text-xs text-slate-400 font-medium tracking-wide text-center">Calidad Certificada</p>
        </div>

        <div class="stat-card relative bg-white/[0.03] border border-[#F8C16D]/20 rounded-2xl p-6 flex flex-col items-center gap-3">
          <span class="absolute top-3 right-3 w-1.5 h-1.5 rounded-full bg-[#F8C16D] animate-pulse"></span>
          <div class="stat-icon-box w-12 h-12 rounded-xl bg-[#F8C16D]/10 border border-[#F8C16D]/20 flex items-center justify-center text-[#F8C16D] text-2xl">
            <i class="ph ph-lightning" aria-hidden="true"></i>
          </div>
          <p class="stat-value text-2xl font-semibold text-slate-100 tracking-tight">100%</p>
          <p class="text-xs text-slate-400 font-medium tracking-wide text-center">Agilidad Digital</p>
        </div>

        <div class="stat-card relative bg-white/[0.03] border border-[#595B5B]/30 rounded-2xl p-6 flex flex-col items-center gap-3">
          <span class="absolute top-3 right-3 w-1.5 h-1.5 rounded-full bg-[#595B5B] animate-pulse"></span>
          <div class="stat-icon-box w-12 h-12 rounded-xl bg-[#595B5B]/20 border border-[#595B5B]/30 flex items-center justify-center text-[#F8C16D] text-2xl">
            <i class="ph ph-globe-hemisphere-west" aria-hidden="true"></i>
          </div>
          <p class="stat-value text-2xl font-semibold text-slate-100 tracking-tight">COL</p>
          <p class="text-xs text-slate-400 font-medium tracking-wide text-center">Alcance Regional</p>
        </div>

        <div class="stat-card relative bg-white/[0.03] border border-[#EE7601]/15 rounded-2xl p-6 flex flex-col items-center gap-3">
          <span class="absolute top-3 right-3 w-1.5 h-1.5 rounded-full bg-[#EE7601] animate-pulse"></span>
          <div class="stat-icon-box w-12 h-12 rounded-xl bg-[#EE7601]/10 border border-[#EE7601]/20 flex items-center justify-center text-[#EE7601] text-2xl">
            <i class="ph ph-users-three" aria-hidden="true"></i>
          </div>
          <p class="stat-value text-2xl font-semibold text-slate-100 tracking-tight">+100</p>
          <p class="text-xs text-slate-400 font-medium tracking-wide text-center">Clientes</p>
        </div>

      </div>
    </div>
  </section>

  <AboutSection />

  <ServicesSection />

  <ProjectsSection />

  <!-- Why Choose Us -->
  <section class="py-24 bg-[#1C1D1D] text-white overflow-hidden relative">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-[radial-gradient(circle_at_center,_rgba(238,118,1,0.14)_0%,_transparent_70%)]"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="section-label-on-dark font-bold uppercase tracking-widest text-sm mb-4">¿Por qué elegirnos?</h2>
          <h3 class="text-4xl lg:text-5xl font-bold mb-8 leading-tight text-white">Lideramos el cambio hacia el futuro educativo</h3>
          <div class="space-y-8">
            {whyUs.map((item) => (
              <WhyUsItem item={item} />
            ))}
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4 pt-12">
            <div class="dark-section-card bg-white/5 backdrop-blur-sm border border-white/10 p-8 rounded-3xl">
              <div class="dark-section-card-icon w-12 h-12 rounded-xl bg-[#EE7601]/10 border border-[#EE7601]/20 flex items-center justify-center mb-4">
                <i data-lucide="cpu" class="w-6 h-6 text-[#F8C16D]" aria-hidden="true"></i>
              </div>
              <h4 class="font-bold text-xl mb-2 text-white">Simuladores</h4>
              <p class="text-slate-300 text-sm">Entornos seguros de práctica profesional.</p>
            </div>
            <div class="dark-section-card bg-white/5 backdrop-blur-sm border border-white/10 p-8 rounded-3xl">
              <div class="dark-section-card-icon w-12 h-12 rounded-xl bg-[#EE7601]/10 border border-[#EE7601]/20 flex items-center justify-center mb-4">
                <i data-lucide="layers" class="w-6 h-6 text-[#595B5B]" aria-hidden="true"></i>
              </div>
              <h4 class="font-bold text-xl mb-2 text-white">LMS Pro</h4>
              <p class="text-slate-300 text-sm">Gestión total del aprendizaje.</p>
            </div>
          </div>
          <div class="space-y-4">
            <div class="dark-section-card bg-white/5 backdrop-blur-sm border border-white/10 p-8 rounded-3xl">
              <div class="dark-section-card-icon w-12 h-12 rounded-xl bg-[#EE7601]/10 border border-[#EE7601]/20 flex items-center justify-center mb-4">
                <i data-lucide="code-2" class="w-6 h-6 text-[#EE7601]" aria-hidden="true"></i>
              </div>
              <h4 class="font-bold text-xl mb-2 text-white">Software</h4>
              <p class="text-slate-300 text-sm">Código escalable y de alta calidad.</p>
            </div>
            <div class="dark-section-card backdrop-blur-sm border border-[#F8C16D]/35 p-8 rounded-3xl bg-[#EE7601]/10">
              <div class="dark-section-card-icon w-12 h-12 rounded-xl bg-[#F8C16D]/10 border border-[#F8C16D]/25 flex items-center justify-center mb-4">
                <i data-lucide="sparkles" class="w-6 h-6 text-[#F8C16D]" aria-hidden="true"></i>
              </div>
              <h4 class="font-bold text-xl mb-2 text-white">Innovación</h4>
              <p class="text-slate-200 text-sm">A la vanguardia de tendencias.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="py-24 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold text-slate-900">Lo que dicen nuestros clientes</h2>
      </div>
      <div class="flex gap-8 animate-scroll w-max">
        {[...testimonials, ...testimonials].map((testimonial) => (
          <TestimonialCard testimonial={testimonial} />
        ))}
      </div>
    </div>
  </section>

  <ResourcesSection />

  <ContactSection />
</MainLayout>